# ==============================================================================
# CENDARO ERP — Environment Configuration Template
# Copy this file to `.env` (and `apps/erp/.env.local` if needed) for local dev.
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# Supabase (use Supavisor transaction pooler `:6543` in serverless production)
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (optional; leave empty in dev to keep the SDK disabled)
# Public DSN, inlined into the client bundle at build time: set it in Vercel
# before the build, and redeploy after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (source map upload + releases). Use an Organization Token
# (Sentry -> Settings -> Auth Tokens); personal read-only tokens fail with 403.
SENTRY_AUTH_TOKEN=

# Mercado Libre (Phase 5)
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_SECRET=
MERCADOLIBRE_REDIRECT_URI=

# AI, Embeddings & Document Processing
GROQ_API_KEY=
# Optional: OpenAI `text-embedding-3-small` (1536-dim) for RAG semantic search;
# falls back deterministically to the local hashed trigram embedder when unset.
OPENAI_API_KEY=
LTX_API_KEY=

# Services
EXCHANGE_RATE_API_KEY=

# Security
# Bearer secret for /api/cron/* (Vercel Cron). At least 32 characters; while
# unset the cron routes answer 503. Generate: openssl rand -hex 32
CRON_SECRET=
# Owner/admin MFA cutover, YYYY-MM-DD (UTC). Empty = not scheduled (no
# blocking, no banner). Set it at least 7 days after the deploy that enables
# it, once every owner/admin has enrolled TOTP at /settings/security.
MFA_ENFORCEMENT_DATE=
# Cloudflare Turnstile CAPTCHA (optional in dev; enforced when secret is set)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Fiscal documents stay off until the numbering is authorized by SENIAT
FISCAL_EMISSION_ENABLED=false

# Scheduled Production Invariants & External Audit Notarization (GitHub Actions / CI)
# Read-only `monitor_reader` connection string (see migration 031 & 033)
PRODUCTION_MONITOR_URL=
SLACK_MONITOR_WEBHOOK_URL=
SENTRY_MONITOR_DSN=
# Optional: external append-only webhook & Ed25519 signing key for daily RFC 6962
# Merkle-root notarization of `public.audit_log`
AUDIT_NOTARIZATION_WEBHOOK_URL=
AUDIT_NOTARIZATION_BEARER_TOKEN=
AUDIT_NOTARY_ED25519_PRIVATE_KEY=

# App
PORT=3000
NODE_ENV=development
