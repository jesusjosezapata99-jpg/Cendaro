# ==============================================================================
# CENDARO ERP — Ironclad Open Source .gitignore
# ==============================================================================

# ── 1. Referencias Externas & Diseños Específicos ────────────────────────────
*midday*
*Midday*

# ── 2. Memoria Operativa Interna, Planes & Reportes de IA ────────────────────
.opencode/
claude_code_implementation_plan
.gemini/
.ops/
graphify-out/
docs/compliance/

# ── 3. Configuraciones Locales de Agentes (Claude & Codex) ───────────────────
.claude/settings.local.json
.claude/mcp.json
.claude/skills/
.claude/agent-memory-local/
.codex/config.toml
.codex/history/

# ── 4. Almacén Binario de Paquetes & Gestores de Dependencias ────────────────
.pnpm-store/
node_modules/
.pnpm-debug.log*

# ── 5. Entorno & Secretos (Ironclad Fencing) ──────────────────────────────────
# Ignora absolutamente todo .env excepto la plantilla pública .env.example
.env
.env.*
!.env.example

# ── 6. Salidas de Compilación, Cachés & Bundles ──────────────────────────────
dist/
.next/
.turbo/
.cache/
out/
design-system/
*.tsbuildinfo

# ── 7. Logs, Depuración & Diagnósticos ───────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 8. Cobertura de Pruebas & Resultados ─────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/

# ── 9. Seguridad & Sentry ────────────────────────────────────────────────────
.sentryclirc

# ── 10. Service Workers & PWA ────────────────────────────────────────────────
sw.js
workbox-*.js

# ── 11. Entorno de Desarrollo (IDEs) & Sistema Operativo ─────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.iml

# OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*
.Spotlight-V100
.Trashes
*~