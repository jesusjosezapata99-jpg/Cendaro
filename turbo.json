{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".cache/tsbuildinfo.json",
        "dist/**",
        ".next/build/**",
        ".next/server/**",
        ".next/static/**",
        ".next/types/**",
        ".next/cache/**",
        ".next/*.json",
        ".next/*.js",
        ".next/BUILD_ID",
        ".next/package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": false
    },
    "@cendaro/erp#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/.eslintcache"]
    },
    "lint:fix": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/.eslintcache"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "generate": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "LTX_API_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "GROQ_API_KEY",
    "EXCHANGE_RATE_API_KEY",
    "CRON_SECRET",
    "MFA_ENFORCEMENT_DATE",
    "MERCADOLIBRE_APP_ID",
    "MERCADOLIBRE_SECRET",
    "MERCADOLIBRE_REDIRECT_URI",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_CONTACT_WHATSAPP",
    "NEXT_PUBLIC_CONTACT_EMAIL",
    "TURNSTILE_SECRET_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "PORT"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
